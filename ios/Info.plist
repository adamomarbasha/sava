<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DEBUG BUILDS ONLY. Release uses Info-Release.plist, which has no ATS
	     exception and no local address. See ios/Sava/Core/Networking/AppConfig.swift. -->

	<!-- Where a development build talks to. Override per-machine with the
	     SAVA_API_BASE environment variable in the scheme, or edit this line.
	     A LAN IP such as http://192.168.1.227:8000 is valid here and is the
	     right way to test against a Mac from a physical phone. -->
	<key>SAVA_API_BASE_URL</key>
	<string>http://localhost:8000</string>

	<!-- Permits http to local-network hosts only. It does NOT allow arbitrary
	     cleartext to the public internet, and it is absent from the Release
	     plist entirely. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sava uses photos you choose to set a collection cover.</string>

	<!-- The published "Save to Sava" iCloud Shortcut, once one exists.

	     Deliberately a sentinel: an iCloud share id only exists after somebody
	     presses Share on a real Shortcut, so it cannot be predicted, and a
	     plausible-looking placeholder would give users a button that 404s.
	     AppConfig rejects anything that is not an https icloud.com URL, and the
	     Action Button screen falls back to the native App Shortcut instructions
	     while it is unset. See docs/ACTION_BUTTON.md. -->
	<key>SAVA_SHARED_SHORTCUT_URL</key>
	<string>REPLACE_WITH_ICLOUD_SHORTCUT_URL</string>
</dict>
</plist>
