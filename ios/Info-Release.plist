<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ══════════════════════════════════════════════════════════════════════
	     THE PRODUCTION API ORIGIN. Release builds talk to this and nothing else.

	     This is Sava's live Render web service. A custom domain is deliberately
	     not in use yet, so the Render-assigned hostname is the correct value
	     rather than a stand-in for one: it is publicly reachable over HTTPS with
	     a valid certificate, which is everything ATS and the validator require.

	     When a custom domain is introduced, change this one line — every request
	     in the app and the share extension resolves against it, so there is no
	     second place to update. Point the domain at the same service first and
	     confirm /health before switching, because a Release build has no
	     fallback by design.

	     It must be https and must not be a local or private address. The
	     "Validate API configuration" build phase fails the Release build if that
	     ever stops being true, so a build pointing at a LAN address cannot be
	     produced by accident.
	     ══════════════════════════════════════════════════════════════════════ -->
	<key>SAVA_API_BASE_URL</key>
	<string>https://sava-api.onrender.com</string>

	<!-- No NSAppTransportSecurity key at all.
	     ATS therefore applies in full: TLS 1.2+, forward secrecy, no cleartext,
	     no local-networking exception. Adding any exception here needs an App
	     Store justification, and Sava has no reason to need one. -->

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Sava uses photos you choose to set a collection cover.</string>

	<!-- The published "Save to Sava" iCloud Shortcut. Optional.

	     Left as the sentinel until a real Shortcut is published from the
	     Shortcuts app — see docs/ACTION_BUTTON.md. Unlike SAVA_API_BASE_URL
	     above, this one does NOT block the Release build: the native App
	     Shortcut works without it, so the setup screen simply shows the
	     instructions instead of a "Get Sava Shortcut" button. -->
	<key>SAVA_SHARED_SHORTCUT_URL</key>
	<string>REPLACE_WITH_ICLOUD_SHORTCUT_URL</string>
</dict>
</plist>
