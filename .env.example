# Sava backend configuration.
#
# Copy to api/.env for local development, or set these as real environment
# variables in your host's dashboard for a deployment. Nothing here has a safe
# production default — the ones that would be dangerous refuse to start instead.

# ─── Required in production ──────────────────────────────────────────────────

# Anything but "development" turns on production behaviour: a real SECRET_KEY
# becomes mandatory and CORS stops allowing localhost.
ENVIRONMENT=production

# JWT signing key. The server REFUSES TO START in production without this.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Postgres with the pgvector extension. SQLite works locally but cannot be used
# by more than one process, does not survive a container restart, and has no
# vector index — so search would load every embedding into Python.
DATABASE_URL=postgresql://user:password@host:5432/sava

# ─── Required for the product to actually work ───────────────────────────────

# Summaries, key points, Ask Sava, collection cover ranking.
GEMINI_API_KEY=

# ─── Object storage (required in production) ─────────────────────────────────
#
# Without these, thumbnails and collection covers are written to the container's
# local disk and disappear on every deploy. Any S3-compatible service works;
# Cloudflare R2 and Backblaze B2 are the cheap ones because neither charges
# egress.
SAVA_S3_BUCKET=
SAVA_S3_ACCESS_KEY_ID=
SAVA_S3_SECRET_ACCESS_KEY=
SAVA_S3_ENDPOINT_URL=
SAVA_S3_REGION=auto
# The public origin objects are served from — a CDN domain in front of the
# bucket. This is what ends up in image URLs the app loads.
SAVA_S3_PUBLIC_BASE_URL=

# ─── Optional ────────────────────────────────────────────────────────────────

# Browser origins allowed to make credentialed requests. The iOS app does not
# need this; a future web client would. Comma-separated, no wildcards.
SAVA_CORS_ORIGINS=

# Session length in minutes. Default 30 days.
SAVA_TOKEN_TTL_MINUTES=43200

# YouTube blocks datacenter IPs. Without a residential proxy, extraction from a
# cloud host fails on the first request. See the deployment notes.
SAVA_PROXY_URL=

# Speech-to-text. "none" (default) skips transcription for content without
# captions; "hosted" uses an OpenAI-compatible endpoint.
SAVA_ASR_PROVIDER=none
SAVA_ASR_BASE_URL=
SAVA_ASR_API_KEY=
