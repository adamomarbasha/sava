# Keep the build context small and, more importantly, keep local secrets and
# other people's media out of the image entirely.
.git
.github
.venv
venv
__pycache__
**/__pycache__
*.pyc

# Never. These exist on a developer machine and must not be baked into an image
# that gets pushed to a registry.
.env
**/.env
*.db
*.sqlite
*.sqlite3
.sava_backups/

# Runtime caches of other people's posts.
static/
api/static/thumbnails/
api/static/objects/
api/static/media/

# Not needed at runtime.
ios/
web/
docs/
.claude/
.DS_Store
**/.DS_Store
